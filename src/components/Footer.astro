---
import { profile } from '../data/resume';
import { pagePath, useI18n } from '../i18n/ui';

const { lang, t } = useI18n(Astro.currentLocale);
const year = new Date().getFullYear();
---

<footer class="bg-band pb-10 text-on-band/70">
  <div class="wrap flex flex-wrap items-center justify-between gap-x-6 gap-y-3 border-t border-on-band/15 pt-6 text-[0.95rem]">
    <p>© {year} {profile.name}</p>
    <ul class="flex flex-wrap items-center gap-x-6 gap-y-2">
      <li>
        <a href={pagePath(lang, 'contact')} class="hover:text-on-band">{t.footerContact}</a>
      </li>
      <li>
        <a href={pagePath(lang, 'privacy')} class="hover:text-on-band">{t.footerPrivacy}</a>
      </li>
      <li>
        <a href={pagePath(lang, 'terms')} class="hover:text-on-band">{t.footerTerms}</a>
      </li>
      <li>
        <a
          href={profile.linkedin}
          class="inline-flex items-center gap-2 font-semibold text-on-band hover:text-amber"
          target="_blank"
          rel="me noopener noreferrer"
          aria-label={t.footerLinkedinLabel}
        >
          <svg class="h-[1.1rem] w-[1.1rem]" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.34V9h3.42v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28ZM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13ZM7.12 20.45H3.56V9h3.56v11.45ZM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0Z" />
          </svg>
          {t.footerLinkedin}
        </a>
      </li>
    </ul>
  </div>
</footer>
