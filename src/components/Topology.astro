---
// Hero version of the network map: one core data center linked to each location.
// The links draw out once on page load.
import { environment } from '../data/resume';
import { W, H, cx, cy, siteLayout, rack } from '../lib/topology';
import { useI18n } from '../i18n/ui';

const { t } = useI18n(Astro.currentLocale);
const count = environment.sites;
const sites = siteLayout(count).map((s) => ({ ...s, delay: 250 + s.i * 55 }));
const units = Array.from({ length: rack.units }, (_, u) => u);
---

<svg
  viewBox={`0 0 ${W} ${H}`}
  class="topology h-auto w-full"
  role="img"
  aria-labelledby="topo-title topo-desc"
>
  <title id="topo-title">{t.mapTitle}</title>
  <desc id="topo-desc">{t.mapDesc(count)}</desc>

  <g class="links">
    {sites.map((s) => (
      <line
        x1={cx}
        y1={cy}
        x2={s.x}
        y2={s.y}
        style={`--len:${s.len};--delay:${s.delay}ms`}
      />
    ))}
  </g>

  <g class="sites">
    {sites.map((s) => (
      <g transform={`translate(${s.x - 9} ${s.y - 9})`}>
        <rect width="18" height="18" rx="3" class="site" />
        <circle cx="9" cy="9" r="3" class="led" style={`--delay:${s.delay + 420}ms`} />
      </g>
    ))}
  </g>

  <g transform={`translate(${cx - rack.w / 2} ${cy - rack.h / 2})`}>
    <rect width={rack.w} height={rack.h} rx="5" class="rack" />
    {units.map((u) => (
      <g transform={`translate(8 ${10 + u * 14})`}>
        <rect width={rack.w - 16} height="9" rx="1.5" class="unit" />
        <circle cx={rack.w - 22} cy="4.5" r="1.8" class="unit-led" />
      </g>
    ))}
  </g>
  <text x={cx} y={cy + rack.h / 2 + 22} text-anchor="middle" class="label">{t.dataCenter}</text>
</svg>

<style>
  .topology line {
    stroke: var(--rule);
    stroke-width: 1.5;
    stroke-linecap: round;
  }
  .site {
    fill: var(--panel);
    stroke: var(--ink);
    stroke-width: 1.5;
  }
  .led,
  .unit-led {
    fill: var(--amber);
  }
  .rack {
    fill: var(--ink);
  }
  .unit {
    fill: var(--field);
    opacity: 0.16;
  }
  .label {
    fill: var(--muted);
    font-size: 14px;
    font-weight: 600;
    font-stretch: 112%;
  }

  /* One load sequence: each link draws out from the core, then its site lights up. */
  @media (prefers-reduced-motion: no-preference) {
    .topology line {
      stroke-dasharray: var(--len);
      stroke-dashoffset: var(--len);
      animation: draw 700ms cubic-bezier(0.3, 0.7, 0.2, 1) var(--delay) forwards;
    }
    .led {
      opacity: 0;
      animation: light 240ms ease-out var(--delay) forwards;
    }
  }
  @keyframes draw {
    to { stroke-dashoffset: 0; }
  }
  @keyframes light {
    to { opacity: 1; }
  }
</style>
