---
// Home page "Get in touch" section: a short form (name, email, message) plus a link to
// the full contact page. Both forms deliver through Formspree; see ContactForm.astro.
import ContactForm from './ContactForm.astro';
import { pagePath, useI18n } from '../i18n/ui';

const { lang, t } = useI18n(Astro.currentLocale);
---

<section id="contact" class="screen flex scroll-mt-16 flex-col justify-center bg-band py-16 text-on-band md:py-24" aria-labelledby="contact-title">
  <div class="wrap grid gap-10 md:grid-cols-[1fr_1.35fr] md:gap-14">
    <div>
      <h2 id="contact-title" class="section-title">{t.contactTitle}</h2>
      <p class="mt-3 max-w-xl text-lg opacity-85">{t.contactBody}</p>
      <a
        href={pagePath(lang, 'contact')}
        class="focus mt-6 inline-block font-semibold underline decoration-amber decoration-2 underline-offset-4 hover:text-amber [&.is-focused]:text-amber"
      >
        {t.contactFull} <span aria-hidden="true">→</span>
      </a>
    </div>
    <div class="rounded-lg border border-rule bg-panel p-5 text-ink sm:p-8">
      <ContactForm basic />
    </div>
  </div>
</section>
