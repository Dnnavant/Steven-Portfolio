---
import Section from './Section.astro';
import { useI18n } from '../i18n/ui';

const { t, c } = useI18n(Astro.currentLocale);
const [featured, ...rest] = c.projects;
---

<Section id="projects" title={t.projectsTitle} intro={t.projectsIntro}>
  <article class="focus focus-card rounded-lg bg-band p-6 text-on-band [transform-origin:center] sm:p-8">
    <h3 class="text-2xl font-bold leading-tight [font-stretch:118%] sm:text-[1.75rem]">{featured.name}</h3>
    <p class="mt-3 max-w-2xl text-lg leading-relaxed opacity-85">{featured.description}</p>
    <ul class="mt-6 flex flex-wrap gap-2" aria-label={t.projectsDelivered}>
      {featured.scope.map((s) => (
        <li class="flex items-center gap-2 rounded border border-on-band/25 px-3 py-1.5 text-[0.92rem]">
          <span class="h-1.5 w-1.5 rounded-full bg-amber" aria-hidden="true"></span>{s}
        </li>
      ))}
    </ul>
  </article>

  <div class="mt-6 grid gap-x-10 gap-y-9 sm:grid-cols-2">
    {rest.map((p) => (
      <article class="focus focus-rule border-t-2 border-ink pt-4">
        <h3 class="focus-accent text-lg font-bold leading-snug [font-stretch:112%]">{p.name}</h3>
        <p class="mt-2 leading-relaxed text-muted">{p.description}</p>
        <p class="mt-3 text-[0.92rem] font-semibold text-amber-ink">{p.scope.join(', ')}</p>
      </article>
    ))}
  </div>
</Section>
