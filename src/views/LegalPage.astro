---
// Privacy Policy and Terms of Use, shared by every language. The text is in
// src/data/legal/; this file only lays it out.
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { profile } from '../data/resume';
import { legal } from '../data/legal';
import { useI18n, withPageLinks } from '../i18n/ui';

interface Props {
  doc: 'privacy' | 'terms';
}

const { doc } = Astro.props;
const { lang, t } = useI18n(Astro.currentLocale);
const { updated } = legal[lang];
const page = legal[lang][doc];
const html = (text: string) => withPageLinks(text, lang);
---

<Base page={doc} title={`${page.title} | ${profile.name}`} description={page.description}>
  <Header page={doc} />
  <main id="main">
    <article
      class="wrap screen py-12 md:py-20 [&_a]:underline [&_a]:decoration-amber [&_a]:decoration-2 [&_a]:underline-offset-4 [&_a:hover]:text-amber-ink"
      aria-labelledby="legal-title"
    >
      <div class="prose-width">
        <h1 id="legal-title" class="display text-[clamp(2.2rem,6vw,3.5rem)] hyphens-auto">{page.title}</h1>
        <p class="mt-4 text-muted">{t.legalUpdated}: {updated}</p>
        <div class="mt-6 space-y-4 text-lg leading-relaxed">
          {page.intro.map((p) => <p set:html={html(p)} />)}
        </div>

        {page.sections.map((s) => (
          <section class="mt-10 border-t border-rule pt-8">
            <h2 class="text-[1.35rem] font-bold leading-snug [font-stretch:115%]">{s.heading}</h2>
            <div class="mt-3 space-y-3 leading-relaxed text-muted [&_strong]:font-semibold [&_strong]:text-ink">
              {s.body.map((b) =>
                Array.isArray(b) ? (
                  <ul class="list-disc space-y-1.5 pl-6 marker:text-amber">
                    {b.map((item) => <li set:html={html(item)} />)}
                  </ul>
                ) : (
                  <p set:html={html(b)} />
                ),
              )}
            </div>
          </section>
        ))}
      </div>
    </article>
  </main>
  <Footer />
</Base>
