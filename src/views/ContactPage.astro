---
// The contact page, shared by every language. Job offers, contract work, and private
// jobs all come in through this form. GitHub Pages can't send email, so submissions go
// to Formspree (formspree.io), which emails them to the inbox the form was created
// for. Only the form's random ID is in the page, never an email address. Until
// profile.contactFormId is filled in, the page shows a LinkedIn link instead of the form.
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { profile } from '../data/resume';
import { languages, useI18n, withPageLinks } from '../i18n/ui';

const { lang, t } = useI18n(Astro.currentLocale);
const ready = profile.contactFormId !== '';
if (ready && !/^[A-Za-z0-9]+$/.test(profile.contactFormId)) {
  throw new Error(
    'contactFormId must be a Formspree form ID (the part after /f/ in the form\'s endpoint, e.g. abcdwxyz), not an email address. See "Contact form setup" in the README.',
  );
}
const endpoint = `https://formspree.io/f/${profile.contactFormId}`;

const field =
  'mt-1.5 block w-full rounded-md border border-rule bg-field px-3.5 py-3 text-base text-ink placeholder:text-muted/70 focus:border-amber focus:outline-none focus-visible:outline-2 focus-visible:outline-amber';
const label = 'block font-semibold [font-stretch:108%]';
const optional = `<span class="font-normal text-muted">${t.optional}</span>`;
---

<Base page="contact" title={t.contactMetaTitle(profile.name)} description={t.contactMetaDesc(profile.name)}>
  <Header page="contact" />
  <main id="main">
    <section class="screen flex flex-col justify-center py-12 md:py-20" aria-labelledby="contact-page-title">
      <div class="wrap grid gap-10 md:grid-cols-[1fr_1.35fr] md:gap-14">
        <div>
          <h1 id="contact-page-title" class="display text-[clamp(2.4rem,6vw,3.75rem)]">{t.contactH1}</h1>
          <p class="prose-width mt-5 text-lg leading-relaxed text-muted">{t.contactIntro}</p>
          <dl class="mt-8 space-y-4 border-l-2 border-amber pl-5">
            <div>
              <dt class="text-muted">{t.openToLabel}</dt>
              <dd class="font-semibold">{t.openToValue}</dd>
            </div>
            <div>
              <dt class="text-muted">{t.responseLabel}</dt>
              <dd class="font-semibold">{t.responseValue}</dd>
            </div>
            <div>
              <dt class="text-muted">{t.basedLabel}</dt>
              <dd class="font-semibold">{profile.location}</dd>
            </div>
          </dl>
        </div>

        <div class="self-center rounded-lg border border-rule bg-panel p-5 sm:p-8">
          {ready ? (
          <form
            action={endpoint}
            method="POST"
            class="space-y-5"
            data-contact-form
            data-msg-sent={t.sent}
            data-msg-error={t.sendError}
            data-msg-cooldown={t.cooldown}
            data-msg-sending={t.sending}
            data-msg-send={t.send}
          >
            <input type="hidden" name="_subject" value="New message from your portfolio" data-subject />
            {/* Tells Steven which language the visitor wrote in. */}
            <input type="hidden" name="language" value={languages[lang].label} />
            {/* Honeypot: real visitors never see or fill this, bots usually do. Formspree also drops these. */}
            <input type="text" name="_gotcha" class="hidden" tabindex="-1" autocomplete="off" aria-hidden="true" />

            <div class="grid gap-5 sm:grid-cols-2">
              <div>
                <label for="name" class={label}>{t.fieldName}</label>
                <input id="name" name="name" type="text" required maxlength="100" autocomplete="name" class={field} />
              </div>
              <div>
                <label for="email" class={label}>{t.fieldEmail}</label>
                <input id="email" name="email" type="email" required maxlength="254" autocomplete="email" class={field} />
              </div>
              <div class="sm:col-span-2">
                <label for="opportunity" class={label}>{t.fieldType}</label>
                <select id="opportunity" name="opportunity" required class={field}>
                  {t.types.map((o) => <option value={o.value}>{o.label}</option>)}
                </select>
              </div>
              <div>
                <label for="company" class={label}>{t.fieldCompany} <Fragment set:html={optional} /></label>
                <input id="company" name="company" type="text" maxlength="120" autocomplete="organization" class={field} />
              </div>
              <div>
                <label for="title" class={label}>{t.fieldTitle} <Fragment set:html={optional} /></label>
                <input id="title" name="title" type="text" maxlength="120" autocomplete="organization-title" class={field} />
              </div>
              <div class="sm:col-span-2">
                <label for="phone" class={label}>{t.fieldPhone} <Fragment set:html={optional} /></label>
                <input id="phone" name="phone" type="tel" maxlength="30" autocomplete="tel" class={field} />
              </div>
            </div>

            <div>
              <label for="message" class={label}>{t.fieldMessage}</label>
              <textarea
                id="message"
                name="message"
                rows="6"
                required
                maxlength="4000"
                class={field}
                placeholder={t.messagePlaceholder}
              ></textarea>
            </div>

            <div class="flex flex-wrap items-center gap-4">
              <button type="submit" class="btn btn-primary disabled:cursor-wait disabled:opacity-60" data-submit>
                {t.send}
              </button>
              <p class="text-[0.95rem] text-muted">{t.sendNote}</p>
            </div>
            <p
              class="text-[0.95rem] text-muted [&_a]:underline [&_a]:decoration-amber [&_a]:decoration-2 [&_a]:underline-offset-4 [&_a:hover]:text-amber-ink"
              set:html={withPageLinks(t.privacyNote, lang)}
            />

            <p role="status" aria-live="polite" class="hidden rounded-md border px-4 py-3 font-semibold" data-form-status></p>
          </form>
          ) : (
            <div class="space-y-4">
              <h2 class="text-[1.35rem] font-bold leading-snug [font-stretch:115%]">{t.formPendingTitle}</h2>
              <p class="leading-relaxed text-muted">{t.formPendingBody}</p>
              <a href={profile.linkedin} class="btn btn-primary" target="_blank" rel="me noopener noreferrer">
                {t.formPendingLink}
              </a>
            </div>
          )}
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Base>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-contact-form]');
  const status = document.querySelector<HTMLElement>('[data-form-status]');
  const submit = form?.querySelector<HTMLButtonElement>('[data-submit]');
  const subject = form?.querySelector<HTMLInputElement>('[data-subject]');
  // Messages come from the page so they match its language.
  const msg = form?.dataset ?? {};

  const show = (ok: boolean, text = '') => {
    if (!status) return;
    status.textContent = text;
    status.classList.remove('hidden', 'border-amber', 'border-red-600', 'text-red-700');
    status.classList.add(...(ok ? ['border-amber'] : ['border-red-600', 'text-red-700']));
  };

  // Spam guards. Bots tend to fill the hidden honeypot field or submit within a second or
  // two of the page loading; both get a fake "sent" so they learn nothing. People who send
  // one message have to wait a minute before sending another.
  const loadedAt = Date.now();
  const COOLDOWN_MS = 60_000;
  const lastSent = () => {
    try {
      return Number(sessionStorage.getItem('contact-sent-at')) || 0;
    } catch {
      return 0;
    }
  };

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const data = new FormData(form);
    if (data.get('_gotcha') || Date.now() - loadedAt < 3000) {
      form.reset();
      show(true, msg.msgSent);
      return;
    }
    if (Date.now() - lastSent() < COOLDOWN_MS) {
      show(false, msg.msgCooldown);
      return;
    }

    // The subject is for Steven, so it stays in English whatever the page language.
    const who = String(data.get('company') || '').trim() || String(data.get('name') || '').trim();
    const kind = String(data.get('opportunity') || 'Message');
    if (subject) subject.value = `${kind}: ${who} is interested in working with you`;
    data.set('_subject', subject?.value ?? '');

    if (submit) {
      submit.disabled = true;
      submit.textContent = msg.msgSending ?? '';
    }
    try {
      // Asking for JSON makes Formspree reply with a status instead of redirecting.
      const res = await fetch(form.action, {
        method: 'POST',
        headers: { Accept: 'application/json' },
        body: data,
      });
      if (!res.ok) throw new Error(String(res.status));
      form.reset();
      try {
        sessionStorage.setItem('contact-sent-at', String(Date.now()));
      } catch {}
      show(true, msg.msgSent);
    } catch {
      show(false, msg.msgError);
    } finally {
      if (submit) {
        submit.disabled = false;
        submit.textContent = msg.msgSend ?? '';
      }
    }
  });
</script>
